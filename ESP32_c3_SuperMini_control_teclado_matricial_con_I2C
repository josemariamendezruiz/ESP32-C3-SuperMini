#include "Wire.h"
#include "I2CKeyPad.h"

const uint8_t KEYPAD_ADDRESS = 0x20;
uint32_t lastKeyPressed = 0;
char keys[] = "123A456B789C*0#DNF";  //  N = Ninguna Tecla , F = Fallo en la recepción

I2CKeyPad teclado(KEYPAD_ADDRESS); // Creamos el objeto teclado

void setup()
{
  Serial.begin(9600);
  Wire.begin();
  if (teclado.begin() == false)
  {
    Serial.println("ERROR: No detecto el módulo del teclado ");
    while(1);
  }
}


void loop()
{
    uint32_t now = millis();
    uint8_t tecla = teclado.getKey();
    
    if ( (tecla <= 15 ) && (now - lastKeyPressed >= 200) ) {
      lastKeyPressed = now;
      Serial.println(keys[tecla]);
    }
}
